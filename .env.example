# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_botfather_token_here

# Telegram Chat ID (your personal ID or group chat ID)
# Retrieve via: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# Delta Exchange Ticker API Endpoint:
# - India (PAXGUSD): https://api.india.delta.exchange/v2/tickers
# - Global (PAXGUSDT): https://api.delta.exchange/v2/tickers
DELTA_TICKER_URL=https://api.india.delta.exchange/v2/tickers

# Market Symbol to track (PAXGUSD or PAXGUSDT)
DELTA_SYMBOL=PAXGUSD

# Polling interval in seconds (default: 30)
POLL_SECONDS=30

# Downward alert threshold step in USD (default: 2.0)
ALERT_STEP=2.0
